# PostgreSQL connection used by the Express API and Drizzle.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/road_roulette

# API server port. The app defaults to 5000 when this is not set.
PORT=5000

# Vite dev server port. The frontend defaults to 5173 when this is not set.
WEB_PORT=5173

# Optional port for the mockup sandbox artifact. It defaults to 5174.
MOCKUP_PORT=5174

# Public base path for the frontend. Use "/" for local development and most hosts.
BASE_PATH=/

# Vite local dev proxy target for /api requests.
API_PROXY_TARGET=http://localhost:5000

# OpenAI-compatible API settings used by banter/chat endpoints.
AI_INTEGRATIONS_OPENAI_API_KEY=replace_me
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional runtime settings.
NODE_ENV=development
LOG_LEVEL=info
